       static const int suffix_buf_size = 16;
diff --git a/src/core/coding/ojph_block_decoder32.cpp b/src/core/coding/ojph_block_decoder32.cpp
index 0151e8d..caad119 100644
--- a/src/core/coding/ojph_block_decoder32.cpp
+++ b/src/core/coding/ojph_block_decoder32.cpp
@@ -315,7 +315,8 @@ namespace ojph {
       if (vlcp->size > 3)  // if there are more than 3 bytes left in VLC
       {
         // (vlcp->data - 3) move pointer back to read 32 bits at once
-        val = *(ui32*)(vlcp->data - 3); // then read 32 bits
+        // val = *(ui32*)(vlcp->data - 3); // then read 32 bits
+        memcpy(&val, (vlcp->data - 3), 4); // copy 32 bits
         vlcp->data -= 4;          // move data pointer back by 4
         vlcp->size -= 4;          // reduce available byte by 4
       }
@@ -1613,4 +1614,4 @@ namespace ojph {
       return true;
     }
   }
-}
\ No newline at end of file
+}
