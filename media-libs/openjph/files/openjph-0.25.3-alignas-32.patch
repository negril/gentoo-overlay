From c7f9581135e034e5f8560e60821e406382ce8f59 Mon Sep 17 00:00:00 2001
From: Paul Zander <negril.nx+gentoo@gmail.com>
Date: Sat, 24 Jan 2026 15:04:19 +0100
Subject: [PATCH] alignas(32)

Signed-off-by: Paul Zander <negril.nx+gentoo@gmail.com>

diff --git a/src/apps/common/ojph_img_io.h b/src/apps/common/ojph_img_io.h
index c18ee76..ac5ee39 100644
--- a/src/apps/common/ojph_img_io.h
+++ b/src/apps/common/ojph_img_io.h
@@ -620,7 +620,7 @@ namespace ojph {
     const char *fname;
     ui32 width, height, num_components;
     ui32 bit_depth, bytes_per_sample;
-    ui8* buffer;
+    alignas(512) ui8* buffer;
     size_t buffer_size;
     ui32 cur_line, samples_per_line, bytes_per_line;
     conversion_fun converter;
@@ -682,7 +682,7 @@ namespace ojph {
     ui32 width, height, num_components;
     ui32 bit_depth_of_data[4]; 
     ui32 bytes_per_sample;
-    ui8* buffer;
+    alignas(512) ui8* buffer;
     size_t buffer_size;
     ui32 cur_line, samples_per_line;
   };
@@ -723,7 +723,7 @@ namespace ojph {
     ui32 num_components;
     ui32 bit_depth;
     ui32 *comp_width;
-    ui8 *buffer;
+    alignas(512) ui8 *buffer;
     ui32 buffer_size;
   };
 
diff --git a/src/apps/others/ojph_img_io_avx2.cpp b/src/apps/others/ojph_img_io_avx2.cpp
index 30ba5a2..2aeaeda 100644
--- a/src/apps/others/ojph_img_io_avx2.cpp
+++ b/src/apps/others/ojph_img_io_avx2.cpp
@@ -131,7 +131,7 @@ namespace ojph {
     const __m256i* sp0 = (__m256i*)ln0->i32;
     const __m256i* sp1 = (__m256i*)ln1->i32;
     const __m256i* sp2 = (__m256i*)ln2->i32;
-    ui8* p = (ui8*)dp;
+    alignas(256)ui8* p = (ui8*)dp;
     for ( ; count >= 32; count -= 32, sp0 += 4, sp1 += 4, sp2 += 4, p += 96)
     {
       __m256i a, t, u, v, w;
